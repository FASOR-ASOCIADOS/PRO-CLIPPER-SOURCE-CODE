/* ------ Rescue5 1.11 (c) APTware 1993,94 ------
     Name: MODINS
   Params: None.
   Return: Undefined
  Example: MODINS()
  ..........................................................................
*/

PROCEDURE MODINS()

   MEMVAR->OPC := " "
   SET(3, 5)
   MENU()
   ESPERE()
   AMAINER()
   DBCLOSEARE()
   AMAIBKE()
   ORDLISTCLE()
   ORDLISTADD("&ZDIS\&WDIRECTO\MAINSBAK")
   ORDLISTREB()
   DBCLOSEARE()
   MEMVAR->SWMODI := 0

   DO WHILE OPC <> "N"

      MENU()
      SETCOLOR("+G")
      DEVPOS(4, 1)
      DEVOUT(PADC("MODIFICACION DE INSUMOS EN MAESTRO", 78))
      SETCOLOR("+W")
      MEMVAR->OPC := " "
      MEMVAR->WCOD := SPACE(4)
      DEVPOS(13, 20)
      DEVOUT("CODIGO ")
      SETPOSBS()
      AADD(GETLIST, __GET(NIL, "WCOD", NIL, NIL, NIL):DISPLAY())
      READMODAL(GETLIST)
      MEMVAR->GETLIST := {}
      SCROLL(12, 20, 13, 60)
      SETPOS(12, 20)

      IF WCOD = "    "

         EXIT

      ENDIF

      IF VAL(WCOD) > 199 .AND. VAL(WCOD) < 300

         MEMVAR->WNUMCOLOR := " "
         DEVPOS(14, 20)
         DEVOUT("NUMERO DEL COLOR ")
         SETPOSBS()
         AADD(GETLIST, __GET(NIL, "WNUMCOLOR", NIL, NIL, NIL):DISPLAY())
         READMODAL(GETLIST)
         MEMVAR->GETLIST := {}

      ENDIF

      AMAINS()
      ORDLISTCLE()
      ORDLISTADD("&ZDIS\&WDIRECTO\COD-INS")
      AMAIBKS()
      ORDLISTCLE()
      ORDLISTADD("&ZDIS\&WDIRECTO\MAINSBAK")

      IF VAL(WCOD) > 199 .AND. VAL(WCOD) < 300

         DBSELECTAR("2")
         __DBLOCATE({||CODIGO = WCOD .AND. NUMCOLOR = WNUMCOLOR}, NIL, NIL,;
                NIL, .F.)
         DBSELECTAR("19")
         __DBLOCATE({||CODIGO = WCOD .AND. NUMCOLOR = WNUMCOLOR}, NIL, NIL,;
                NIL, .F.)

      ELSE

         DBSELECTAR("2")
         DBSEEK("&WCOD")
         DBSELECTAR("19")
         DBSEEK("&WCOD")

      ENDIF

      DBSELECTAR("2")

      IF EOF()

         DBSELECTAR("2")
         DBCLOSEARE()
         DBSELECTAR("19")
         DBCLOSEARE()
         SETCOLOR("+G")
         DEVPOS(15, 20)
         DEVOUT("CODIGO NO EXISTE")
         MEMVAR->X := INKEY(0)
         LOOP

      ENDIF

      DBSELECTAR("19")
      MEMVAR->WPOS19 := RECNO()
      DBCLOSEARE()
      SET(27, "ON")
      DBSELECTAR("2")
      MEMVAR->WLIN := LINEA
      MEMVAR->WCOD := CODIGO
      MEMVAR->WNOM := NOMBRE
      MEMVAR->WCOLOR := COLOR
      MEMVAR->WNUMCOLOR := NUMCOLOR
      MEMVAR->WNOMFASOR := NOMFASOR
      MEMVAR->WUNI := UNIDAD
      MEMVAR->WUNIPROV := UNIPROV
      MEMVAR->WFACTUNI := FACTUNI
      MEMVAR->WMIN := MINIMO
      MEMVAR->WMAX := MAXIMO
      MEMVAR->WPR1 := COSTO1
      MEMVAR->WESC := ESCALA
      MEMVAR->WPR2 := COSTO2
      MEMVAR->WULTMOV := ULTMOV
      MEMVAR->WSALUNI := SALDOUNI
      MEMVAR->WSALPES := SALDOPES
      MEMVAR->WENTMESUNI := ENTMESUNI
      MEMVAR->WENTMESPES := ENTMESPES
      MEMVAR->WOTRENMEUN := OTRENMEUNI
      MEMVAR->WOTRENMEPE := OTRENMEPES
      MEMVAR->WCONMESUNI := CONMESUNI
      MEMVAR->WCONMESPES := CONMESPES
      MEMVAR->WOTRSAMESU := OTRSAMESUN
      MEMVAR->WOTRSAMESP := OTRSAMESPE
      MEMVAR->WCOSCONMES := COSCONMES
      MEMVAR->WENTANOUNI := ENTANOUNI
      MEMVAR->WENTANOPES := ENTANOPES
      MEMVAR->WOTRENANOU := OTRENANOUN
      MEMVAR->WOTRENANOP := OTRENANOPE
      MEMVAR->WCONANOUNI := CONANOUNI
      MEMVAR->WCONANOPES := CONANOPES
      MEMVAR->WOTRSAANOU := OTRSAANOUN
      MEMVAR->WOTRSAANOP := OTRSAANOPE
      MEMVAR->WCOSCONANO := COSCONANO
      MEMVAR->WPOS2 := RECNO()
      DBCLOSEARE()
      MEMVAR->SWLEE := 0
      MENINS()
      MEMVAR->OPC := " "
      DISPBOX(24, 2, 24, 79, 2)
      SETCOLOR("W")
      RUTMODIN()
      AMAINS()
      ORDLISTCLE()
      ORDLISTADD("&ZDIS\&WDIRECTO\COD-INS")
      __DBLOCATE({||CODIGO = WCOD .AND. NUMCOLOR = WNUMCOLOR .AND. RECNO() ;
            <> WPOS2}, NIL, NIL, NIL, .F.)

      IF  .NOT. EOF() .AND. WPOS2 <> RECNO()

         DBCLOSEARE()
         SETCOLOR("R")
         QOUT(CHR(7))
         SCROLL(24, 20, 22, 78)
         SETPOS(24, 20)
         DEVPOS(24, 10)
         DEVOUT("ESTE CODIGO YA EXISTE")
         MEMVAR->X := INKEY(0)
         LOOP

      ENDIF

      MEMVAR->SWCOL := 0
      MEMVAR->SWCOL := IF(VAL(WCOD) > 199 .AND. VAL(WCOD) < 300, 1, 0)
      DBSELECTAR("2")
      DBGOTO(WPOS2)
      VEALOCK()
      FIELD->LINEA := WLIN
      FIELD->CODIGO := WCOD
      FIELD->CODNUM := VAL(WCOD)
      FIELD->NOMFASOR := UPPER(WNOMFASOR)
      FIELD->NOMBRE := UPPER(WNOM)

      IF SWCOL = 1

         FIELD->COLOR := UPPER(WCOLOR)
         FIELD->NUMCOLOR := WNUMCOLOR

      ELSE

         FIELD->COLOR := SPACE(10)
         FIELD->NUMCOLOR := " "

      ENDIF

      FIELD->UNIDAD := WUNI
      FIELD->MINIMO := WMIN
      FIELD->MAXIMO := WMAX
      FIELD->COSTO1 := WPR1
      FIELD->ESCALA := WESC
      FIELD->COSTO2 := WPR2
      FIELD->ULTMOV := WULTMOV
      FIELD->SALDOUNI := WSALUNI
      FIELD->SALDOPES := WSALPES
      FIELD->ENTMESUNI := WENTMESUNI
      FIELD->ENTMESPES := WENTMESPES
      FIELD->OTRENMEUNI := WOTRENMEUN
      FIELD->OTRENMEPES := WOTRENMEPE
      FIELD->CONMESUNI := WCONMESUNI
      FIELD->CONMESPES := WCONMESPES
      FIELD->OTRSAMESUN := WOTRSAMESU
      FIELD->OTRSAMESPE := WOTRSAMESP
      FIELD->COSCONMES := WCOSCONMES
      FIELD->ENTANOUNI := WENTANOUNI
      FIELD->ENTANOPES := WENTANOPES
      FIELD->OTRENANOUN := WOTRENANOU
      FIELD->OTRENANOPE := WOTRENANOP
      FIELD->CONANOUNI := WCONANOUNI
      FIELD->CONANOPES := WCONANOPES
      FIELD->OTRSAANOUN := WOTRSAANOU
      FIELD->OTRSAANOPE := WOTRSAANOP
      FIELD->COSCONANO := WCOSCONANO
      FIELD->UNIPROV := WUNIPROV
      FIELD->FACTUNI := WFACTUNI
      AMAIBKS()
      ORDLISTCLE()
      ORDLISTADD("&ZDIS\&WDIRECTO\MAINSBAK")
      DBGOTO(WPOS19)
      VEALOCK()
      FIELD->LINEA := WLIN
      FIELD->CODIGO := WCOD
      FIELD->CODNUM := VAL(WCOD)
      FIELD->NOMFASOR := UPPER(WNOMFASOR)
      FIELD->NOMBRE := UPPER(WNOM)

      IF SWCOL = 1

         FIELD->COLOR := UPPER(WCOLOR)
         FIELD->NUMCOLOR := WNUMCOLOR

      ELSE

         FIELD->COLOR := SPACE(10)
         FIELD->NUMCOLOR := " "

      ENDIF

      FIELD->UNIDAD := WUNI
      FIELD->MINIMO := WMIN
      FIELD->MAXIMO := WMAX
      FIELD->COSTO1 := WPR1
      FIELD->ESCALA := WESC
      FIELD->COSTO2 := WPR2
      FIELD->ULTMOV := WULTMOV
      FIELD->SALDOUNI := WSALUNI
      FIELD->SALDOPES := WSALPES
      FIELD->ENTMESUNI := WENTMESUNI
      FIELD->ENTMESPES := WENTMESPES
      FIELD->OTRENMEUNI := WOTRENMEUN
      FIELD->OTRENMEPES := WOTRENMEPE
      FIELD->CONMESUNI := WCONMESUNI
      FIELD->CONMESPES := WCONMESPES
      FIELD->OTRSAMESUN := WOTRSAMESU
      FIELD->OTRSAMESPE := WOTRSAMESP
      FIELD->COSCONMES := WCOSCONMES
      FIELD->ENTANOUNI := WENTANOUNI
      FIELD->ENTANOPES := WENTANOPES
      FIELD->OTRENANOUN := WOTRENANOU
      FIELD->OTRENANOPE := WOTRENANOP
      FIELD->CONANOUNI := WCONANOUNI
      FIELD->CONANOPES := WCONANOPES
      FIELD->OTRSAANOUN := WOTRSAANOU
      FIELD->OTRSAANOPE := WOTRSAANOP
      FIELD->COSCONANO := WCOSCONANO
      FIELD->UNIPROV := WUNIPROV
      FIELD->FACTUNI := WFACTUNI
      DBCLOSEARE()

   ENDDO

   SET(27, "OFF")
   ESPERE()
   BORMAIBK()
   AMAINS()
   __DBCOPY("&ZDIS\&WDIRECTO\MAINSU.BAK", {}, NIL, NIL, NIL, NIL, .F., NIL)
   MEMVAR->WAB := "BASURA.DBF"
   BA()
   __DBSORT("C:\BASURA", {"CODNUM", "NUMCOLOR"}, NIL, NIL, NIL, NIL, .F.)
   DBCLOSEARE()
   FERASE("&ZDIS\&WDIRECTO\&FMAINSU")
   DBUSEAREA(.F., NIL, "C:\BASURA", NIL, NIL, .F.)
   __DBCOPY("&ZDIS\&WDIRECTO\&FMAINSU", {}, NIL, NIL, NIL, NIL, .F., NIL)
   DBCLOSEARE()
   AMAINE()
   FERASE("&ZDIS\&WDIRECTO\COD-INS.NTX")
   DBCREATEIN("&ZDIS\&WDIRECTO\COD-INS", "CODIGO", {||CODIGO}, NIL)
   DBCLOSEARE()
   BORMAIBK()
   AMAIBKE()
   __DBCOPY("&ZDIS\&WDIRECTO\MAINSU.BAK", {}, NIL, NIL, NIL, NIL, .F., NIL)
   MEMVAR->WAB := "BASURA.DBF"
   BA()
   MEMVAR->WAB := "BASURA.NTX"
   BA()
   DBCREATEIN("C:\BASURA", "CODNUM+VAL(NUMCOLOR)", {||CODNUM + VAL(;
         NUMCOLOR)}, NIL)
   __DBCOPY("C:\BASURA", {}, NIL, NIL, NIL, NIL, .F., NIL)
   DBCLOSEARE()
   FERASE("&ZDIS\&WDIRECTO\MAINSBAK.DBF")
   DBUSEAREA(.F., NIL, "C:\BASURA", NIL, NIL, .F.)
   __DBCOPY("&ZDIS\&WDIRECTO\MAINSBAK.DBF", {}, NIL, NIL, NIL, NIL, .F., ;
         NIL)
   MEMVAR->WAB := "BASURA.DBF"
   BA()
   AMAIBKE()
   FERASE("&ZDIS\&WDIRECTO\MAINSBAK.NTX")
   DBCREATEIN("&ZDIS\&WDIRECTO\MAINSBAK", "CODIGO", {||CODIGO}, NIL)
   DBCLOSEARE()
   MEMVAR->OPC := " "
   DBCLOSEARE()
   SET(3, 2)

RETURN 

