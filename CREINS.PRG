     Name: CREINS
   Params: None.
   Return: Undefined
  Example: CREINS()
  ..........................................................................
*/

PROCEDURE CREINS()

   MEMVAR->OPC := " "
   SET(3, 5)
   MENU()
   AMAINER()

   IF  .NOT. FILE("&ZDIS\&WDIRECTO\MAINSBAK.DBF")

      __DBCOPY("&ZDIS\&WDIRECTO\MAINSBAK.DBF", {}, NIL, NIL, NIL, NIL, .F.,;
             NIL)

   ENDIF

   DBCLOSEARE()
   AMAIBKE()

   IF FILE("&ZDIS\&WDIRECTO\MAINSBAK.NTX")

      FERASE("&ZDIS\&WDIRECTO\MAINSBAK.NTX")

   ENDIF

   DBCREATEIN("&ZDIS\&WDIRECTO\MAINSBAK.NTX", "CODIGO", {||CODIGO}, NIL)
   DBCLOSEARE()
   MEMVAR->SWMODI := 1

   DO WHILE OPC <> "N"

      MENU()
      MEMVAR->WMIN := MEMVAR->WMAX := MEMVAR->WPR1 := MEMVAR->WESC := MEMVAR->;
            WPR2 := MEMVAR->WSALUNI := MEMVAR->WSALPES := MEMVAR->WENTMESUNI ;
            := MEMVAR->WENTMESPES := MEMVAR->WOTRENMEUN := MEMVAR->WOTRENMEPE ;
            := MEMVAR->WCONMESUNI := MEMVAR->WCONMESPES := MEMVAR->WOTRSAMESU ;
            := MEMVAR->WOTRSAMESP := MEMVAR->WCOSCONMES := MEMVAR->WENTANOUNI ;
            := MEMVAR->WENTANOPES := MEMVAR->WOTRENANOU := MEMVAR->WOTRENANOP ;
            := MEMVAR->WCONANOUNI := 0
      MEMVAR->WCONANOPES := MEMVAR->WOTRSAANOU := MEMVAR->WOTRSAANOP := ;
            MEMVAR->WCOSCONANO := MEMVAR->WLIN := MEMVAR->WFACTUNI := 0
      MEMVAR->OPC := MEMVAR->WNUMCOLOR := " "
      MEMVAR->WCOD := SPACE(4)
      MEMVAR->WCOLOR := MEMVAR->WUNI := MEMVAR->WUNIPROV := SPACE(10)
      MEMVAR->WNOM := MEMVAR->WNOMFASOR := SPACE(20)
      MEMVAR->WULTMOV := DATE()
      SETCOLOR("+GR")
      DEVPOS(4, 25)
      DEVOUT("CREACION DE INSUMOS EN MAESTRO")
      MEMVAR->SWLEE := 1
      MENINS()
      SETCOLOR("W")

      IF WLIN = 0

         EXIT

      ENDIF

      SETCOLOR("G")
      MEMVAR->OPC := " "
      DEVPOS(24, 20)
      DEVOUT("ESTA TODO CORRECTO ? S/N ")
      SETPOSBS()
      AADD(GETLIST, __GET(NIL, "OPC", "@!", {||OPC $ "SN"}, NIL):DISPLAY())
      READMODAL(GETLIST)
      MEMVAR->GETLIST := {}
      DISPBOX(24, 2, 24, 79, 2)
      SETCOLOR("W")

      IF OPC <> "S"

         RUTMODIN()

      ENDIF

      MEMVAR->SWCOL := 0
      AMAINS()
      ORDLISTCLE()
      ORDLISTADD("&ZDIS\&WDIRECTO\COD-INS")

      IF VAL(WCOD) > 199 .AND. VAL(WCOD) < 300

         MEMVAR->SWCOL := 1
         __DBLOCATE({||CODIGO = WCOD .AND. NUMCOLOR = WNUMCOLOR}, NIL, NIL,;
                NIL, .F.)

      ELSE

         DBSEEK("&WCOD")

      ENDIF

      IF  .NOT. EOF()

         DBCLOSEARE()
         SETCOLOR("R")
         QOUT(CHR(7))
         SCROLL(24, 5, 24, 78)
         SETPOS(24, 5)
         DEVPOS(24, 10)
         DEVOUT("ESTE CODIGO YA EXISTE")
         MEMVAR->X := INKEY(0)
         LOOP

      ENDIF

      DBAPPEND()
      FIELD->LINEA := WLIN
      FIELD->CODIGO := WCOD
      FIELD->CODNUM := VAL(WCOD)

      IF SWCOL = 0

         FIELD->NUMCOLOR := " "
         FIELD->COLOR := SPACE(10)

      ELSE

         FIELD->NUMCOLOR := WNUMCOLOR
         FIELD->COLOR := WCOLOR

      ENDIF

      FIELD->NOMFASOR := WNOMFASOR
      FIELD->NOMBRE := WNOM
      FIELD->UNIDAD := WUNI
      FIELD->MINIMO := WMIN
      FIELD->MAXIMO := WMAX
      FIELD->COSTO1 := WPR1
      FIELD->ESCALA := WESC
      FIELD->COSTO2 := WPR2
      FIELD->ULTMOV := WULTMOV
      FIELD->SALDOUNI := WSALUNI
      FIELD->SALDOPES := WSALPES
      FIELD->ENTMESUNI := WENTMESUNI
      FIELD->ENTMESPES := WENTMESPES
      FIELD->OTRENMEUNI := WOTRENMEUN
      FIELD->OTRENMEPES := WOTRENMEPE
      FIELD->CONMESUNI := WCONMESUNI
      FIELD->CONMESPES := WCONMESPES
      FIELD->OTRSAMESUN := WOTRSAMESU
      FIELD->OTRSAMESPE := WOTRSAMESP
      FIELD->COSCONMES := WCOSCONMES
      FIELD->ENTANOUNI := WENTANOUNI
      FIELD->ENTANOPES := WENTANOPES
      FIELD->OTRENANOUN := WOTRENANOU
      FIELD->OTRENANOPE := WOTRENANOP
      FIELD->CONANOUNI := WCONANOUNI
      FIELD->CONANOPES := WCONANOPES
      FIELD->OTRSAANOUN := WOTRSAANOU
      FIELD->OTRSAANOPE := WOTRSAANOP
      FIELD->COSCONANO := WCOSCONANO
      FIELD->UNIPROV := WUNIPROV
      FIELD->FACTUNI := WFACTUNI
      DBCLOSEARE()
      AMAIBKS()
      ORDLISTCLE()
      ORDLISTADD("&ZDIS\&WDIRECTO\MAINSBAK")
      DBAPPEND()
      FIELD->LINEA := WLIN
      FIELD->CODIGO := WCOD
      FIELD->CODNUM := VAL(WCOD)

      IF SWCOL = 0

         FIELD->NUMCOLOR := " "
         FIELD->COLOR := SPACE(10)

      ELSE

         FIELD->NUMCOLOR := WNUMCOLOR
         FIELD->COLOR := WCOLOR

      ENDIF

      FIELD->NOMFASOR := WNOMFASOR
      FIELD->NOMBRE := WNOM
      FIELD->UNIDAD := WUNI
      FIELD->MINIMO := WMIN
      FIELD->MAXIMO := WMAX
      FIELD->COSTO1 := WPR1
      FIELD->ESCALA := WESC
      FIELD->COSTO2 := WPR2
      FIELD->ULTMOV := WULTMOV
      FIELD->SALDOUNI := WSALUNI
      FIELD->SALDOPES := WSALPES
      FIELD->ENTMESUNI := WENTMESUNI
      FIELD->ENTMESPES := WENTMESPES
      FIELD->OTRENMEUNI := WOTRENMEUN
      FIELD->OTRENMEPES := WOTRENMEPE
      FIELD->CONMESUNI := WCONMESUNI
      FIELD->CONMESPES := WCONMESPES
      FIELD->OTRSAMESUN := WOTRSAMESU
      FIELD->OTRSAMESPE := WOTRSAMESP
      FIELD->COSCONMES := WCOSCONMES
      FIELD->ENTANOUNI := WENTANOUNI
      FIELD->ENTANOPES := WENTANOPES
      FIELD->OTRENANOUN := WOTRENANOU
      FIELD->OTRENANOPE := WOTRENANOP
      FIELD->CONANOUNI := WCONANOUNI
      FIELD->CONANOPES := WCONANOPES
      FIELD->OTRSAANOUN := WOTRSAANOU
      FIELD->OTRSAANOPE := WOTRSAANOP
      FIELD->COSCONANO := WCOSCONANO
      FIELD->UNIPROV := WUNIPROV
      FIELD->FACTUNI := WFACTUNI
      DBCLOSEARE()

   ENDDO

   MEMVAR->OPC := " "
   ESPERE()
   BORMAIBK()
   AMAINS()
   __DBCOPY("&ZDIS\&WDIRECTO\MAINSU.BAK", {}, NIL, NIL, NIL, NIL, .F., NIL)
   MEMVAR->WAB := "BASURA.DBF"
   BA()
   __DBSORT("C:\PROTMP\BASURA", {"CODNUM", "NUMCOLOR"}, NIL, NIL, NIL, NIL, .F.)
   DBCLOSEARE()
   FERASE("&ZDIS\&WDIRECTO\&FMAINSU")
   DBUSEAREA(.F., NIL, "C:\PROTMP\BASURA", NIL, NIL, .F.)
   __DBCOPY("&ZDIS\&WDIRECTO\&FMAINSU", {}, NIL, NIL, NIL, NIL, .F., NIL)
   DBCLOSEARE()
   MEMVAR->WAB := "BASURA.DBF"
   BA()
   AMAINE()
   FERASE("&ZDIS\&WDIRECTO\COD-INS.NTX")
   DBCREATEIN("&ZDIS\&WDIRECTO\COD-INS", "CODIGO", {||CODIGO}, NIL)
   DBCLOSEARE()
   BORMAIBK()
   AMAIBKE()
   __DBCOPY("&ZDIS\&WDIRECTO\MAINSU.BAK", {}, NIL, NIL, NIL, NIL, .F., NIL)
   MEMVAR->WAB := "BASURA.DBF"
   BA()
   MEMVAR->WAB := "BASURA.NTX"
   BA()
   DBCREATEIN("C:\PROTMP\BASURA", "CODNUM+VAL(NUMCOLOR)", {||CODNUM + VAL(;
         NUMCOLOR)}, NIL)
   __DBCOPY("C:\PROTMP\BASURA", {}, NIL, NIL, NIL, NIL, .F., NIL)
   DBCLOSEARE()
   FERASE("&ZDIS\&WDIRECTO\MAINSBAK.DBF")
   DBUSEAREA(.F., NIL, "C:\PROTMP\BASURA", NIL, NIL, .F.)
   __DBCOPY("&ZDIS\&WDIRECTO\MAINSBAK.DBF", {}, NIL, NIL, NIL, NIL, .F., ;
         NIL)
   DBCLOSEARE()
   MEMVAR->WAB := "BASURA.DBF"
   BA()
   AMAIBKE()
   FERASE("&ZDIS\&WDIRECTO\MAINSBAK.NTX")
   DBCREATEIN("&ZDIS\&WDIRECTO\MAINSBAK.NTX", "CODIGO", {||CODIGO}, NIL)
   DBCLOSEARE()
   SET(3, 2)

RETURN 

